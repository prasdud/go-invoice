# Server
BASE_URL=http://localhost:8080
PORT=8080
API_KEY=changeme
LOG_LEVEL=info

# Branding (header text, hex color, optional PNG/JPEG logo path, max 1 MiB)
COMPANY_NAME=Acme Corp
COMPANY_COLOR=284878
# COMPANY_LOGO=./logo.png

# Capacity
MAX_CONCURRENT_RENDERS=16
ADMISSION_WAIT_MS=1000
RENDER_TIMEOUT_SECONDS=10

# S3-compatible storage (AWS S3 / Cloudflare R2 / local s3mock from compose)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=invoices
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_USE_PATH_STYLE=true
